# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Production builds
dist/
*/dist/
**/dist/
build/
*/build/
**/build/

# Environment variables & secrets (Protects all DB credentials, OpenAI keys, JWT secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env
**/.env
**/.env.*
**/*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Credentials, Keys & Certificates
*credentials*
*secret*
*.pem
*.key
*.cert
*.crt
id_rsa*

# Logs & Databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.sqlite
*.sqlite3
*.db
dump/

# Editor and OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

